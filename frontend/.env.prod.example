# YourPace Frontend - Production Environment
# These variables are injected by Amplify from GitHub Secrets during build
# See docs/GITHUB_SECRETS.md for the required GitHub Secrets configuration
# .env.prod is in .gitignore and should NEVER be committed

# Cognito Configuration (from GitHub Secrets)
# Required secrets: COGNITO_REGION, COGNITO_USER_POOL_CLIENT_ID, COGNITO_AUTH_DOMAIN_PROD
NEXT_PUBLIC_COGNITO_REGION=eu-west-1
NEXT_PUBLIC_COGNITO_CLIENT_ID=<from COGNITO_USER_POOL_CLIENT_ID secret>
NEXT_PUBLIC_COGNITO_DOMAIN=<from COGNITO_AUTH_DOMAIN_PROD secret>

# Frontend Domain (from GitHub Secrets)
# Required secret: APP_URL
NEXT_PUBLIC_APP_URL=https://www.yourpace.cloud

# CloudFront Distribution ID (from GitHub Secrets)
# Required secret: AWS_CLOUDFRONT_DISTRIBUTION_ID_PROD
NEXT_PUBLIC_CLOUDFRONT_DISTRIBUTION_ID=<from AWS_CLOUDFRONT_DISTRIBUTION_ID_PROD secret>

# AWS Configuration (from GitHub Secrets)
# Required secrets: AWS_REGION, AWS_ACCOUNT_ID
NEXT_PUBLIC_AWS_REGION=<from AWS_REGION secret>
NEXT_PUBLIC_AWS_ACCOUNT_ID=<from AWS_ACCOUNT_ID secret>

# DynamoDB Tables (from GitHub Secrets)
# Required secrets: DYNAMODB_USERS_TABLE, DYNAMODB_WORKOUTS_TABLE, DYNAMODB_EXERCISES_TABLE, DYNAMODB_GOALS_TABLE
NEXT_PUBLIC_USERS_TABLE=<from DYNAMODB_USERS_TABLE secret>
NEXT_PUBLIC_WORKOUTS_TABLE=<from DYNAMODB_WORKOUTS_TABLE secret>
NEXT_PUBLIC_EXERCISES_TABLE=<from DYNAMODB_EXERCISES_TABLE secret>
NEXT_PUBLIC_GOALS_TABLE=<from DYNAMODB_GOALS_TABLE secret>

# S3 Buckets (from GitHub Secrets)
# Required secrets: S3_ASSETS_BUCKET, S3_FRONTEND_BUCKET
NEXT_PUBLIC_ASSETS_BUCKET=<from S3_ASSETS_BUCKET secret>
NEXT_PUBLIC_FRONTEND_BUCKET=<from S3_FRONTEND_BUCKET secret>

# VPC Configuration (from GitHub Secrets)
# Required secrets: VPC_ID, LAMBDA_SECURITY_GROUP_ID
NEXT_PUBLIC_VPC_ID=<from VPC_ID secret>
NEXT_PUBLIC_LAMBDA_SECURITY_GROUP_ID=<from LAMBDA_SECURITY_GROUP_ID secret>

# Route53 Configuration (from GitHub Secrets)
# Required secret: HOSTED_ZONE_ID
NEXT_PUBLIC_HOSTED_ZONE_ID=<from HOSTED_ZONE_ID secret>

# CloudFront Configuration (from GitHub Secrets)
# Required secret: CLOUDFRONT_DOMAIN_PROD
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=<from CLOUDFRONT_DOMAIN_PROD secret>

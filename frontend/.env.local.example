# Copy this to .env.local and fill in values after CDK deploy
# Get these from CDK stack outputs:
#   npx cdk deploy --all -c env=dev -c domainName=yourpace.cloud --profile yourpace-dev

NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=eu-west-1
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com

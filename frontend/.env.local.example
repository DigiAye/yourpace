# YourPace Frontend Environment Variables
# Copy this file to .env.local and fill in the values
# .env.local is in .gitignore and should NEVER be committed

# Cognito Configuration
NEXT_PUBLIC_COGNITO_REGION=eu-west-1
NEXT_PUBLIC_COGNITO_CLIENT_ID=<from CloudFormation stack outputs>
NEXT_PUBLIC_COGNITO_DOMAIN=<from CloudFormation stack outputs>

# Frontend Domain
NEXT_PUBLIC_APP_URL=https://yourpace.cloud

# CloudFront Distribution ID (for cache invalidation)
NEXT_PUBLIC_CLOUDFRONT_DISTRIBUTION_ID=<from CloudFormation stack outputs>

# AWS Configuration
NEXT_PUBLIC_AWS_REGION=eu-west-1
NEXT_PUBLIC_AWS_ACCOUNT_ID=230984464810

# DynamoDB Tables
NEXT_PUBLIC_USERS_TABLE=yourpace-users-prod
NEXT_PUBLIC_WORKOUTS_TABLE=yourpace-workouts-prod
NEXT_PUBLIC_EXERCISES_TABLE=yourpace-exercises-prod
NEXT_PUBLIC_GOALS_TABLE=yourpace-goals-prod

# S3 Buckets
NEXT_PUBLIC_ASSETS_BUCKET=yourpace-assets-prod
NEXT_PUBLIC_FRONTEND_BUCKET=yourpace-frontend-prod

# VPC Configuration
NEXT_PUBLIC_VPC_ID=<from CloudFormation stack outputs>
NEXT_PUBLIC_LAMBDA_SECURITY_GROUP_ID=<from CloudFormation stack outputs>

# Route53 Configuration
NEXT_PUBLIC_HOSTED_ZONE_ID=Z02794812UW0G2U4GTHPL

# CloudFront Configuration
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=<from CloudFormation stack outputs>

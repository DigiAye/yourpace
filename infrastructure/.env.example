# Infrastructure Environment Variables
# Copy this file to .env.local and fill in the actual values

# AWS Configuration
AWS_ACCOUNT_ID=
AWS_REGION=eu-west-1
AWS_PROFILE=yourpace-dev

# Domain Configuration
DOMAIN_NAME=yourpace.cloud
HOSTED_ZONE_ID=

# Environment (dev, staging, prod)
ENVIRONMENT=dev

# Cognito Configuration (optional - for custom setup)
COGNITO_DOMAIN_PREFIX=auth-dev
COGNITO_CALLBACK_URLS=https://dev.yourpace.cloud/auth/callback

# API Configuration (optional)
API_DOMAIN=api-dev.yourpace.cloud

# DynamoDB Configuration (optional - for custom setup)
DYNAMODB_BILLING_MODE=PAY_PER_REQUEST
DYNAMODB_POINT_IN_TIME_RECOVERY=false

# S3 Configuration (optional)
S3_VERSIONING_ENABLED=false
S3_AUTO_DELETE_ON_DESTROY=true

# NAT Gateway Configuration (optional)
NAT_GATEWAY_COUNT=1
